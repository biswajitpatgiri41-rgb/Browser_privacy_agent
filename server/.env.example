# Server-specific environment configuration
# This file is loaded by the server. Copy to server/.env

APP_ENV=production
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8000

PLANNER_BACKEND=transformers

MODEL_BASE=Qwen/Qwen2.5-1.5B-Instruct
MODEL_ADAPTER_PATH=./models/planner-lora/Final_model
MODEL_DEVICE=auto
MODEL_MAX_NEW_TOKENS=160
MODEL_TEMPERATURE=0

API_PROVIDER=openai
API_MODEL=gpt-4o-mini
API_KEY=
API_BASE_URL=
API_TIMEOUT_SECONDS=30

MAX_CONTEXT_ELEMENTS=200
MAX_REQUEST_BYTES=1048576
MAX_TASK_LENGTH=2000

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_PAYLOAD_VALIDATION=true
