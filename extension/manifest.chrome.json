
{
	"manifest_version": 3,
	"name": "Private Lens",
	"version": "0.1.0",
	"description": "A privacy-first browser agent that keeps sensitive browsing details on your side.",
	"action": {
		"default_title": "Private Lens",
		"default_popup": "src/popup/popup.html"
	},
	"permissions": ["storage", "scripting", "activeTab"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "src/background/service-worker.ts",
		"type": "module"
	},
	"content_scripts": [],
	"icons": {}
}
