# privacy-vision-browser-agent Environment Configuration
# Copy to .env and fill in values. Never commit .env with real secrets.

# Application
APP_ENV=production
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8000

# Planner Backend: api | transformers
PLANNER_BACKEND=transformers

# Transformers Backend (used when PLANNER_BACKEND=transformers)
MODEL_BASE=Qwen/Qwen2.5-1.5B-Instruct
MODEL_ADAPTER_PATH=
MODEL_DEVICE=auto

# API Backend (used when PLANNER_BACKEND=api)
API_PROVIDER=openai
API_MODEL=gpt-4o-mini
API_KEY=
API_BASE_URL=
API_TIMEOUT_SECONDS=30

# Request Limits
MAX_CONTEXT_ELEMENTS=200
MAX_REQUEST_BYTES=1048576
MAX_TASK_LENGTH=2000

# Security
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_PAYLOAD_VALIDATION=true
